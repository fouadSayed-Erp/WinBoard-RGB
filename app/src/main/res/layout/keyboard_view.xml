<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#121214" android:padding="4dp">

    <!-- Top Bar زي الفيديو -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="⌨️ WinBoard PC" android:textColor="#FFFFFF" android:textSize="12sp"/>
        <Button android:id="@+id/btnSettings" android:layout_width="36dp" android:layout_height="36dp" android:text="⚙️" android:background="@drawable/key_carbon"/>
        <Button android:id="@+id/btnToggle" android:layout_width="36dp" android:layout_height="36dp" android:text="🖱️" android:backgroundTint="#0A84FF" android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- الكيبورد PC الكامل -->
    <LinearLayout android:id="@+id/keysContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

    <!-- التراك باد المدمج -->
    <LinearLayout android:id="@+id/trackpadContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/trackpad_bg" android:padding="8dp" android:layout_marginTop="6dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TRACKPAD • اسحب للتحكم • ضغطة = كليك شمال • اصبعين = كليك يمين" android:textColor="#888888" android:textSize="10sp" android:gravity="center"/>
        <View android:id="@+id/trackpadView" android:layout_width="match_parent" android:layout_height="120dp" android:background="#1E1E20" android:layout_marginTop="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
            <Button android:id="@+id/btnLeft" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="Left" android:textSize="10sp" android:backgroundTint="#2B2B2B"/>
            <Button android:id="@+id/btnRight" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="Right" android:textSize="10sp" android:backgroundTint="#2B2B2B" android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
