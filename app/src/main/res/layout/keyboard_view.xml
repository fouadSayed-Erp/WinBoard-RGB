<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#121214" android:padding="6dp">

    <!-- زرار التحويل -->
    <Button android:id="@+id/btnToggle"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="🔵 Trackpad • دوس للتحويل لتراك باد مدمج" android:backgroundTint="#0A84FF"
        android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>

    <!-- لوحة المفاتيح الكاملة -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/keysContainer">
    </LinearLayout>

    <!-- التراك باد المدمج -->
    <LinearLayout android:id="@+id/trackpadContainer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/trackpad_bg"
        android:padding="12dp" android:layout_marginTop="8dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="TRACKPAD • لوحة اللمس" android:textColor="#888" android:textSize="11sp" android:letterSpacing="0.1"/>

        <View android:id="@+id/trackpadView"
            android:layout_width="match_parent" android:layout_height="140dp"
            android:layout_marginTop="8dp" android:background="#1E1E20"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Trackpad - اسحب للتحكم في الماوس | ضغطة = كليك شمال | ضغطتين بصابعين = كليك يمين"
            android:textColor="#AAA" android:textSize="11sp" android:gravity="center" android:layout_marginTop="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnLeft" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Left Click" android:backgroundTint="#3A3A3C" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/btnRight" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Right Click" android:backgroundTint="#3A3A3C" android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
